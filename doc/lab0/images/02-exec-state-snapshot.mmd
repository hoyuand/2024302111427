%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, Microsoft YaHei, sans-serif","primaryColor":"#ffffff","primaryTextColor":"#000000","primaryBorderColor":"#000000","lineColor":"#000000","secondaryColor":"#ffffff","tertiaryColor":"#ffffff"},"flowchart":{"nodeSpacing":30,"rankSpacing":44,"curve":"linear"}}}%%
flowchart TB
  classDef plain fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px
  classDef note fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1px,stroke-dasharray:4 3
  moment["截面：kexec 已提交 echo 新镜像，尚未执行第一条用户指令<br/>S态｜echo 内核栈｜echo=RUNNING"]:::plain
  subgraph PROCS["一 struct proc 状态"]
    direction LR
    init["init<br/>state=SLEEPING｜parent=无<br/>pagetable=PT_init"]:::plain
    shell["shell<br/>state=SLEEPING(wait)｜parent=init<br/>pagetable=PT_shell"]:::plain
    echo["echo<br/>state=RUNNING｜parent=shell<br/>pagetable=PT_echo｜sz=0x4000<br/>ofile[0..2]=F_console"]:::plain
    echo -->|parent| shell -->|parent| init
  end
  subgraph SV39["二 echo 的 Sv39 地址空间（低地址到高地址）"]
    direction LR
    pt["PT_echo 根页表 L2"]:::plain
    low["L2[0] → L1[0] → L0"]:::plain
    p0["0x0000–0x0fff text/rodata<br/>V R X U"]:::plain
    p1["0x1000–0x1fff data/bss<br/>V R W U"]:::plain
    p2["0x2000–0x2fff guard<br/>V R W；U=0"]:::plain
    p3["0x3000–0x3fff user stack<br/>V R W U；向低地址增长"]:::plain
    gap["……未映射空洞……"]:::plain
    high["L2[255] → L1[511] → L0"]:::plain
    tf["TRAPFRAME<br/>0x3fffffe000 | V R W；U=0"]:::plain
    tr["TRAMPOLINE<br/>0x3ffffff000 | V R X；U=0"]:::plain
    pt --> low --> p0
    low --> p1
    low --> p2
    low --> p3
    p3 --> gap
    gap --> high --> tf
    high --> tr
  end
  subgraph FILES["三 文件描述符继承"]
    direction LR
    ofs["init / shell / echo<br/>各自 ofile[0], ofile[1], ofile[2]"]:::plain
    fc["同一 struct file<br/>FD_DEVICE｜ref=9｜major=1"]:::plain
    ino["console inode<br/>T_DEVICE | major=1"]:::plain
    dev["devsw[1].write<br/>consolewrite → uartwrite<br/>UART0 MMIO 0x10000000"]:::plain
    ofs -->|fork + filedup| fc -->|ip| ino
    fc -->|major 索引| dev
  end
  moment --> echo
  echo --> pt
  echo --> ofs
  n1["个人思考1（TRAMPOLINE 同址映射）：<br/>切换 satp 后仍要继续取指；<br/>因此用户、内核页表必须把同一物理代码页映射到同一最高虚拟地址。"]:::note
  n2["个人思考2（exec 提交点）：<br/>先在新页表中装载 ELF、guard、stack 和 argv，<br/>全部成功后才一次性替换 pagetable、sz、epc、sp。"]:::note
  n3["个人思考3（文件引用）：<br/>fork 对每个 fd 调用 filedup；<br/>父子共享 struct file，但 close 仍按引用计数回收。"]:::note
  tr -.-> n1
  moment -.-> n2
  fc -.-> n3
