  moment["Lab0 | 杜浩源 | 2024302111427<br/>截面：kexec提交echo新镜像，尚未执行首条用户指令<br/>S态 | echo内核栈 | echo=RUNNING"]:::plain
  subgraph PROCS[1 struct proc]
    direction TB
