%%{init: {"theme":"base","themeVariables":{"fontSize":"17px","fontFamily":"Microsoft YaHei, Arial, sans-serif"},"flowchart":{"nodeSpacing":28,"rankSpacing":38,"curve":"basis"}}}%%
flowchart TB
  classDef user fill:#e9f6ec,stroke:#24733a,color:#111,stroke-width:2px
  classDef kernel fill:#eaf1fb,stroke:#315f9f,color:#111,stroke-width:2px
  classDef sched fill:#f3ecf8,stroke:#77459a,color:#111,stroke-width:2px
  classDef device fill:#fff1d7,stroke:#aa6500,color:#111,stroke-width:2px
  classDef note fill:#fff9d9,stroke:#8a7000,color:#111,stroke-width:1.5px
  classDef legend fill:#f7f7f7,stroke:#666,color:#111,stroke-dasharray:4 3

  subgraph INPUT[1 输入、阻塞与唤醒]
    direction LR
    i1["Shell: read(0)<br/>U态 | 用户栈 | 无锁"]:::user
    i2["ecall -> uservec -> usertrap<br/>syscall -> sys_read<br/>S态 | Shell内核栈 | 无锁"]:::kernel
    i3["consoleread: 缓冲区为空<br/>cons.lock -> sleep_prepare<br/>SLEEPING；p.lock交给scheduler"]:::kernel
    i4["scheduler / wfi<br/>S态 | CPU调度器栈 | 检查时持p.lock"]:::sched
    i5["键入 echo hi + Enter<br/>UART IRQ 10 -> PLIC"]:::device
    i6["kerneltrap -> devintr -> uartintr<br/>consoleintr写缓冲并wakeup<br/>S态 | 内核/调度器栈 | cons.lock"]:::kernel
    i7["Shell RUNNABLE -> RUNNING<br/>swtch；read返回；userret -> sret<br/>U态 | Shell用户栈 | 无锁"]:::user
    n1["个人思考1｜sleep先登记chan再释放cons.lock，<br/>避免检查与睡眠之间丢失唤醒。"]:::note
    legend["Lab0 | 杜浩源 | 2024302111427<br/>标签：特权级 | 当前栈 | 自旋锁<br/>中断已委托S态；M态只参与启动配置。"]:::legend

    i1 --> i2 --> i3 --> i4
    i5 --> i6 --> i7
    i4 -->|选择Shell| i7
    i3 -.-> n1
  end

  subgraph CREATE[2 fork、exec 与 wait]
    direction LR
    f1["Shell: parsecmd -> fork<br/>U态 | Shell用户栈 | 无锁"]:::user
    f2["sys_fork -> kfork<br/>复制页表、trapframe、ofile<br/>S态 | Shell内核栈"]:::kernel
    f3["父Shell: fork返回child pid<br/>wait无ZOMBIE -> SLEEPING"]:::kernel
    f4["子进程: fork返回0 -> exec(echo)<br/>U态 -> S态 | 子进程内核栈"]:::user
    f5["kexec: 装载ELF、guard、stack<br/>全部成功后提交pagetable/sz/epc/sp"]:::kernel
    f6["userret -> sret -> echo main<br/>U态 | echo用户栈 | 无锁"]:::user
    n2["个人思考2｜exec先构造新地址空间再一次提交，<br/>失败时原程序仍可继续。"]:::note

    f1 --> f2
    f2 -->|父: a0=child pid| f3
    f2 -->|子: a0=0| f4 --> f5 --> f6
    f5 -.-> n2
  end

  subgraph OUTPUT[3 write、exit 与回收]
    direction LR
    o1["echo: write(1, hi) + write(1, newline)<br/>U态 | echo用户栈 | 无锁"]:::user
    o2["sys_write -> filewrite<br/>devsw[1].write -> consolewrite<br/>S态 | echo内核栈"]:::kernel
    o3["uartwrite<br/>持uart_tx_lock；满则sleep并释放锁<br/>空闲则写UART THR"]:::device
    o4["UART发送完成 -> 屏幕显示 hi<br/>中断唤醒等待发送者"]:::device
    o5["exit -> fileclose -> ZOMBIE<br/>wait_lock + p.lock；wakeup(parent)<br/>sched交回调度器"]:::kernel
    o6["父Shell被echo唤醒并调度<br/>wait找到ZOMBIE；freeproc回收<br/>继续getcmd"]:::sched
    n3["个人思考3｜ZOMBIE不是资源泄漏：<br/>文件已关闭，只保留wait所需状态。"]:::note

    o1 --> o2 --> o3 --> o4 --> o5 --> o6
    o5 -.-> n3
  end

  i7 --> f1
  f6 --> o1
  f3 -. "echo退出后唤醒" .-> o6
